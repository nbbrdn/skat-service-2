# Copy to .env and populate both empty secrets before running Compose.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=service.skatpower.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://service.skatpower.ru
DJANGO_HSTS_SECONDS=3600
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=skat
POSTGRES_USER=skat
POSTGRES_PASSWORD=

GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
